{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic temporal capture sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frames"],
  "properties": {
    "schemaVersion": {"const": 1},
    "frames": {"type": "integer", "minimum": 1, "maximum": 10000},
    "sampleFrames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/frame"}},
    "objectNode": {"type": "integer", "minimum": 0},
    "objectName": {"type": "string"},
    "camera": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frame", "position", "target"], "properties": {"frame": {"$ref": "#/$defs/frame"}, "position": {"$ref": "#/$defs/vec3"}, "target": {"$ref": "#/$defs/vec3"}}}},
    "objectTranslation": {"$ref": "#/$defs/translations"},
    "bimTranslation": {"$ref": "#/$defs/translations"},
    "events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frame"], "properties": {
      "frame": {"$ref": "#/$defs/frame"},
      "reset": {"type": "boolean"}, "skip": {"type": "boolean"}, "taa": {"type": "boolean"},
      "objectVisible": {"type": "boolean"}, "minimized": {"type": "boolean"}, "orthographic": {"type": "boolean"},
      "acquireOutOfDate": {"type": "boolean"}, "presentSuboptimal": {"type": "boolean"},
      "samples": {"enum": [1, 2, 4, 8]}, "exposure": {"type": "number", "minimum": 0},
      "resize": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 16384}},
      "technique": {"enum": ["forward-raster", "deferred-raster"]}, "reload": {"type": "string"},
      "guiReload": {"type": "string", "description": "Queue a model load through the Scene Controls request path"},
      "guiSampleModel": {"type": "string", "description": "Select a discovered Sample model by its UI label"},
      "guiUnload": {"type": "boolean", "description": "Queue Unload model through the Scene Controls request path"},
      "guiWaitForLoad": {"type": "boolean", "default": true, "description": "Set false to render the pending GUI model request without settling it; requires a GUI model action"},
      "bimHiddenObject": {"type": "integer", "minimum": 0, "maximum": 4294967295},
      "bimSelectedObject": {"type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Select a BIM object through the browser/viewport selection path"},
      "bimLodBias": {"type": "integer", "minimum": -8, "maximum": 8},
      "areaLightPosition": {"$ref": "#/$defs/vec3"},
      "rayShadows": {"enum": ["raster", "hard", "soft"]},
      "rayShadowSamples": {"type": "integer", "minimum": 1, "maximum": 32},
      "rayShadowDenoise": {"type": "boolean"},
      "areaLighting": {"enum": ["ltc", "sampled"]},
      "areaLightSamples": {"enum": [9, 25, 64]},
      "ddgiEnabled": {"type": "boolean"},
      "ddgiPaused": {"type": "boolean"},
      "ddgiFitProbes": {"type": "integer", "minimum": 27, "maximum": 4294967295, "description": "Queue a one-shot scene fit through the DDGI control path; does not enable GI"},
      "sectionPlane": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
    }, "allOf": [{
      "if": {"required": ["guiWaitForLoad"], "properties": {"guiWaitForLoad": {"const": false}}},
      "then": {"anyOf": [
        {"required": ["guiReload"], "properties": {"guiReload": {"type": "string", "minLength": 1}}},
        {"required": ["guiSampleModel"], "properties": {"guiSampleModel": {"type": "string", "minLength": 1}}},
        {"required": ["guiUnload"], "properties": {"guiUnload": {"const": true}}}
      ]}
    }]}}
  },
  "$defs": {
    "frame": {"type": "integer", "minimum": 1, "maximum": 10000},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "translations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frame", "translation"], "properties": {"frame": {"$ref": "#/$defs/frame"}, "translation": {"$ref": "#/$defs/vec3"}}}}
  }
}
