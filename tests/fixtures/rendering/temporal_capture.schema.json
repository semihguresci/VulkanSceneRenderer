{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic temporal capture sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frames"],
  "properties": {
    "schemaVersion": {"const": 1},
    "frames": {"type": "integer", "minimum": 1, "maximum": 10000},
    "sampleFrames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/frame"}},
    "objectNode": {"type": "integer", "minimum": 0},
    "objectName": {"type": "string"},
    "camera": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frame", "position", "target"], "properties": {"frame": {"$ref": "#/$defs/frame"}, "position": {"$ref": "#/$defs/vec3"}, "target": {"$ref": "#/$defs/vec3"}}}},
    "objectTranslation": {"$ref": "#/$defs/translations"},
    "bimTranslation": {"$ref": "#/$defs/translations"},
    "events": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frame"], "properties": {
      "frame": {"$ref": "#/$defs/frame"},
      "reset": {"type": "boolean"}, "skip": {"type": "boolean"}, "taa": {"type": "boolean"},
      "objectVisible": {"type": "boolean"}, "minimized": {"type": "boolean"}, "orthographic": {"type": "boolean"},
      "acquireOutOfDate": {"type": "boolean"}, "presentSuboptimal": {"type": "boolean"},
      "samples": {"enum": [1, 2, 4, 8]}, "exposure": {"type": "number", "minimum": 0},
      "animationClip": {"type": "integer", "minimum": -1},
      "gltfScene": {"type": "integer", "minimum": 0, "maximum": 2147483647},
      "animationTime": {"type": "number", "minimum": 0},
      "animationPlaying": {"type": "boolean"},
      "depthProbe": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 16384}},
      "resize": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 16384}},
      "technique": {"enum": ["forward-raster", "deferred-raster", "path-tracing"]}, "reload": {"type": "string"},
      "guiReload": {"type": "string", "description": "Queue a model load through the Scene Controls request path"},
      "guiSampleModel": {"type": "string", "description": "Select a discovered Sample model by its UI label"},
      "guiUnload": {"type": "boolean", "description": "Queue Unload model through the Scene Controls request path"},
      "guiWaitForLoad": {"type": "boolean", "default": true, "description": "Set false to render the pending GUI model request without settling it; requires a GUI model action"},
      "bimHiddenObject": {"type": "integer", "minimum": 0, "maximum": 4294967295},
      "bimRoomVolumesVisible": {"type": "boolean", "description": "Show or hide IFC room geometry"},
      "bimSelectedObject": {"type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Select a BIM object through the browser/viewport selection path"},
      "bimLodBias": {"type": "integer", "minimum": -8, "maximum": 8},
      "lightEdit": {"$ref": "#/$defs/lightEdit"},
      "lightSelection": {"$ref": "#/$defs/lightTarget"},
      "lightAdd": {"$ref": "#/$defs/lightAdd"},
      "nodeEdit": {"$ref": "#/$defs/nodeEdit"},
      "nodeFlags": {"type": "object", "required": ["sourceNode"], "minProperties": 2,
        "additionalProperties": false, "properties": {"sourceNode": {"$ref": "#/$defs/nodeSourceIndex"},
        "visible": {"type": "boolean"}, "selectable": {"type": "boolean"}, "hoverable": {"type": "boolean"}}},
      "addPrimitive": {"enum": ["Quad", "Plane (double-sided wall)", "Cube", "Sphere", "Triangular Prism", "Pyramid", "Torus"]},
      "sceneHistory": {"enum": ["undo", "redo"]},
      "expectLightEditFailure": {"type": "boolean", "default": false},
      "areaLightPosition": {"$ref": "#/$defs/vec3"},
      "rayShadows": {"enum": ["raster", "hard", "soft"]},
      "rayShadowSamples": {"type": "integer", "minimum": 1, "maximum": 32},
      "rayShadowDenoise": {"type": "boolean"},
      "areaLighting": {"enum": ["ltc", "sampled"]},
      "areaLightSamples": {"enum": [9, 25, 64]},
      "ddgiEnabled": {"type": "boolean"},
      "ddgiPaused": {"type": "boolean"},
      "ddgiFitProbes": {"type": "integer", "minimum": 27, "maximum": 4294967295, "description": "Queue a one-shot scene fit through the DDGI control path; does not enable GI"},
      "sectionPlane": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
    }, "allOf": [{
      "if": {"required": ["guiWaitForLoad"], "properties": {"guiWaitForLoad": {"const": false}}},
      "then": {"anyOf": [
        {"required": ["guiReload"], "properties": {"guiReload": {"type": "string", "minLength": 1}}},
        {"required": ["guiSampleModel"], "properties": {"guiSampleModel": {"type": "string", "minLength": 1}}},
        {"required": ["guiUnload"], "properties": {"guiUnload": {"const": true}}}
      ]}
    }, {
      "if": {"anyOf": [{"required": ["lightEdit"]}, {"required": ["lightSelection"]}, {"required": ["lightAdd"]}, {"required": ["nodeEdit"]}, {"required": ["nodeFlags"]}, {"required": ["addPrimitive"]}, {"required": ["sceneHistory"]}]},
      "then": {"allOf": [
        {"oneOf": [{"required": ["lightEdit"]}, {"required": ["lightSelection"]}, {"required": ["lightAdd"]}, {"required": ["nodeEdit"]}, {"required": ["nodeFlags"]}, {"required": ["addPrimitive"]}, {"required": ["sceneHistory"]}]},
        {"propertyNames": {"enum": ["frame", "gltfScene", "lightEdit", "lightSelection", "lightAdd", "nodeEdit", "nodeFlags", "addPrimitive", "sceneHistory", "expectLightEditFailure", "taa", "exposure", "resize", "depthProbe", "technique", "rayShadows", "rayShadowSamples", "rayShadowDenoise", "areaLighting", "areaLightSamples", "ddgiPaused", "ddgiEnabled", "samples", "reset"]}}
      ]}
    }, {
      "if": {"required": ["expectLightEditFailure"]},
      "then": {"$ref": "#/$defs/oneLightAction"}
    }]}}
  },
  "$defs": {
    "nodeSourceIndex": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "nodeEdit": {
      "type": "object", "additionalProperties": false, "required": ["operation"],
      "allOf": [{"oneOf": [{"required": ["sourceNode"]}, {"required": ["graphNode"]}]}],
      "properties": {
        "sourceNode": {"$ref": "#/$defs/nodeSourceIndex"},
        "graphNode": {"$ref": "#/$defs/nodeSourceIndex"},
        "operation": {"enum": ["select", "transform", "visibility", "reparent", "begin", "update", "end", "cancel"]},
        "matrix": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/lightFloat"}},
        "visible": {"type": "boolean"},
        "parent": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nodeSourceIndex"}]},
        "delta": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -16384, "maximum": 16384}},
        "gizmo": {"type": "object", "additionalProperties": false, "required": ["tool"], "properties": {
          "tool": {"enum": ["translate", "rotate", "scale"]}, "space": {"enum": ["world", "local"]},
          "axis": {"enum": ["free", "x", "y", "z"]}, "snap": {"type": "boolean"}}}
      },
      "oneOf": [
        {"properties": {"operation": {"enum": ["select", "end", "cancel"]}}, "maxProperties": 2},
        {"properties": {"operation": {"const": "transform"}}, "required": ["matrix"], "maxProperties": 3},
        {"properties": {"operation": {"const": "visibility"}}, "required": ["visible"], "maxProperties": 3},
        {"properties": {"operation": {"const": "reparent"}}, "required": ["parent"], "maxProperties": 3},
        {"properties": {"operation": {"const": "begin"}}, "required": ["gizmo", "delta"], "maxProperties": 4},
        {"properties": {"operation": {"const": "update"}}, "required": ["delta"], "maxProperties": 3}
      ]
    },
    "lightType": {"enum": ["point", "spot", "area", "directional"]},
    "safeLightInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "lightFloat": {"type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38},
    "lightVector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/lightFloat"}},
    "oneLightAction": {"oneOf": [{"required": ["lightEdit"]}, {"required": ["lightSelection"]}, {"required": ["lightAdd"]}]},
    "lightTarget": {
      "type": "object", "additionalProperties": false, "required": ["type", "source"],
      "properties": {"type": {"$ref": "#/$defs/lightType"}, "source": {"enum": ["imported", "manual", "generated"]},
        "sourceNode": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "nodeName": {"type": "string", "minLength": 1, "maxLength": 4096},
        "index": {"type": "integer", "minimum": 0, "maximum": 4294967294}},
      "oneOf": [{"required": ["sourceNode"]}, {"required": ["nodeName"]}, {"required": ["index"]}],
      "allOf": [{"if": {"properties": {"source": {"const": "imported"}}},
        "then": {"not": {"required": ["index"]}}, "else": {"required": ["index"]}}]
    },
    "lightValues": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"position": {"$ref": "#/$defs/lightVector"}, "direction": {"$ref": "#/$defs/lightVector"},
        "color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 3.4028234663852886e38}},
        "intensity": {"type": "number", "minimum": 0, "maximum": 3.4028234663852886e38},
        "range": {"type": "number", "minimum": 0, "maximum": 3.4028234663852886e38},
        "spotCone": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 179}},
        "areaSize": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38}},
        "areaShape": {"enum": ["rectangle", "disk"]},
        "areaBasis": {"type": "object", "additionalProperties": false, "required": ["tangent", "bitangent"],
          "properties": {"tangent": {"$ref": "#/$defs/lightVector"}, "bitangent": {"$ref": "#/$defs/lightVector"}}}}
    },
    "lightGizmo": {
      "type": "object", "additionalProperties": false, "required": ["tool", "amount"],
      "properties": {"tool": {"enum": ["translate", "rotate", "scale"]}, "amount": {"$ref": "#/$defs/lightVector"},
        "space": {"enum": ["world", "local"], "default": "world"}, "axis": {"enum": ["free", "x", "y", "z"], "default": "free"},
        "snap": {"type": "boolean", "default": false}}
    },
    "lightEdit": {
      "type": "object", "additionalProperties": false, "required": ["target", "phase"],
      "properties": {"target": {"$ref": "#/$defs/lightTarget"}, "phase": {"enum": ["commit", "begin", "update", "end", "cancel"]},
        "gesture": {"$ref": "#/$defs/safeLightInteger"}, "expectedLightRevision": {"$ref": "#/$defs/safeLightInteger"},
        "values": {"$ref": "#/$defs/lightValues"}, "gizmo": {"$ref": "#/$defs/lightGizmo"}},
      "allOf": [{"if": {"properties": {"phase": {"const": "commit"}}}, "then": {"not": {"required": ["gesture"]}}, "else": {"required": ["gesture"]}},
        {"if": {"properties": {"phase": {"enum": ["end", "cancel"]}}}, "then": {"not": {"anyOf": [{"required": ["values"]}, {"required": ["gizmo"]}]}},
          "else": {"oneOf": [{"required": ["values"]}, {"required": ["gizmo"]}]}},
        {"if": {"properties": {"target": {"properties": {"type": {"const": "directional"}}}}}, "then": {"properties": {"values": {"not": {"anyOf": [{"required": ["position"]}, {"required": ["range"]}, {"required": ["spotCone"]}, {"required": ["areaSize"]}, {"required": ["areaShape"]}, {"required": ["areaBasis"]}]}}}}},
        {"if": {"properties": {"target": {"properties": {"type": {"const": "point"}}}}}, "then": {"properties": {"values": {"not": {"anyOf": [{"required": ["direction"]}, {"required": ["spotCone"]}, {"required": ["areaSize"]}, {"required": ["areaShape"]}, {"required": ["areaBasis"]}]}}}}},
        {"if": {"properties": {"target": {"properties": {"type": {"const": "spot"}}}}}, "then": {"properties": {"values": {"not": {"anyOf": [{"required": ["areaSize"]}, {"required": ["areaShape"]}, {"required": ["areaBasis"]}]}}}}},
        {"if": {"properties": {"target": {"properties": {"type": {"const": "area"}}}}}, "then": {"properties": {"values": {"not": {"required": ["spotCone"]}}}}}]
    },
    "lightAdd": {"type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {"type": {"$ref": "#/$defs/lightType"}, "expectedLightRevision": {"$ref": "#/$defs/safeLightInteger"}}},
    "frame": {"type": "integer", "minimum": 1, "maximum": 10000},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "translations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["frame", "translation"], "properties": {"frame": {"$ref": "#/$defs/frame"}, "translation": {"$ref": "#/$defs/vec3"}}}}
  }
}
