ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Finite orthogonal LiDAR targets in millimetres'),'2;1');
FILE_NAME('lidar-corner.ifc','2026-11-27T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2=IFCUNITASSIGNMENT((#1));
#3=IFCPROJECT('0000000000000000000003',$,'LiDAR corner',$,$,$,$,(#9),#2);
#4=IFCCARTESIANPOINT((0.,0.,0.));
#5=IFCDIRECTION((0.,0.,1.));
#6=IFCDIRECTION((1.,0.,0.));
#7=IFCAXIS2PLACEMENT3D(#4,#5,#6);
#8=IFCLOCALPLACEMENT($,#7);
#9=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,0.001,#7,$);

#10=IFCCARTESIANPOINT((0.,0.,-200.));
#11=IFCAXIS2PLACEMENT3D(#10,#5,#6);
#12=IFCLOCALPLACEMENT(#8,#11);
#13=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,12000.,12000.);
#14=IFCEXTRUDEDAREASOLID(#13,#7,#5,200.);
#15=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#14));
#16=IFCPRODUCTDEFINITIONSHAPE($,$,(#15));
#17=IFCSLAB('0000000000000000000017',$,'Floor',$,$,#12,#16,$,.FLOOR.);

/* IFC (x,y,z) maps to REP-103 (y,-x,z). The near face is X=4 m. */
#20=IFCCARTESIANPOINT((-625.,4125.,0.));
#21=IFCAXIS2PLACEMENT3D(#20,#5,#6);
#22=IFCLOCALPLACEMENT(#8,#21);
#23=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,5250.,250.);
#24=IFCEXTRUDEDAREASOLID(#23,#7,#5,3000.);
#25=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#24));
#26=IFCPRODUCTDEFINITIONSHAPE($,$,(#25));
#27=IFCWALL('0000000000000000000027',$,'Positive X wall',$,$,#22,#26,$,.STANDARD.);

/* The near face is Y=3 m. It meets the X wall without overlapping. */
#30=IFCCARTESIANPOINT((-3125.,1000.,0.));
#31=IFCAXIS2PLACEMENT3D(#30,#5,#6);
#32=IFCLOCALPLACEMENT(#8,#31);
#33=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,250.,6000.);
#34=IFCEXTRUDEDAREASOLID(#33,#7,#5,3000.);
#35=IFCSHAPEREPRESENTATION(#9,'Body','SweptSolid',(#34));
#36=IFCPRODUCTDEFINITIONSHAPE($,$,(#35));
#37=IFCWALL('0000000000000000000037',$,'Positive Y wall',$,$,#32,#36,$,.STANDARD.);

#40=IFCBUILDINGSTOREY('0000000000000000000040',$,'Ground storey',$,$,#8,$,$,.ELEMENT.,0.);
#41=IFCBUILDING('0000000000000000000041',$,'LiDAR corner building',$,$,#8,$,$,.ELEMENT.,$,$,$);
#42=IFCSITE('0000000000000000000042',$,'LiDAR corner site',$,$,#8,$,$,.ELEMENT.,$,$,$,$,$);
#43=IFCRELAGGREGATES('0000000000000000000043',$,$,$,#3,(#42));
#44=IFCRELAGGREGATES('0000000000000000000044',$,$,$,#42,(#41));
#45=IFCRELAGGREGATES('0000000000000000000045',$,$,$,#41,(#40));
#46=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000046',$,$,$,(#17,#27,#37),#40);
ENDSEC;
END-ISO-10303-21;
