<?xml version="1.0" encoding="utf-8"?>
<robot name="two_link_arm">
  <!-- All lengths are metres and all angles are radians in REP-103 link frames. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.0456" ixy="0" ixz="0" iyy="0.0456" iyz="0" izz="0.0768"/>
    </inertial>
    <visual name="pedestal_visual">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.16" length="0.12"/></geometry>
    </visual>
    <collision name="pedestal_collision">
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.16" length="0.12"/></geometry>
    </collision>
  </link>

  <link name="upper_arm">
    <inertial>
      <origin xyz="0.29 0.01 -0.01" rpy="0 0 0.12"/>
      <mass value="2.4"/>
      <inertia ixx="0.004" ixy="0.0015" ixz="-0.0006" iyy="0.074" iyz="0.0004" izz="0.074"/>
    </inertial>
    <visual name="upper_arm_visual">
      <origin xyz="0.30 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.10 0.10"/></geometry>
    </visual>
    <collision name="upper_arm_collision">
      <origin xyz="0.30 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.10 0.10"/></geometry>
    </collision>
  </link>

  <link name="forearm">
    <inertial>
      <origin xyz="0.225 -0.005 0.01" rpy="0.10 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.00128" ixy="-0.0003" ixz="0.0002" iyy="0.02089" iyz="0.0001" izz="0.02089"/>
    </inertial>
    <visual name="forearm_visual">
      <origin xyz="0.225 0 0" rpy="0 0 0"/>
      <geometry><box size="0.45 0.08 0.08"/></geometry>
    </visual>
    <visual name="tip_marker">
      <origin xyz="0.45 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.035"/></geometry>
    </visual>
    <collision name="forearm_collision">
      <origin xyz="0.225 0 0" rpy="0 0 0"/>
      <geometry><box size="0.45 0.08 0.08"/></geometry>
    </collision>
  </link>

  <!-- Shoulder travel is +/- pi/2 rad, limited to 8 N m and 1.5 rad/s. -->
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0.10 -0.20 0.25" rpy="0 0 1.5707963267948966"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="8.0" velocity="1.5"/>
  </joint>

  <!-- Elbow travel is [-1.2, 1.8] rad, limited to 3 N m and 2 rad/s. -->
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.60 0.05 0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.8" effort="3.0" velocity="2.0"/>
  </joint>
</robot>
