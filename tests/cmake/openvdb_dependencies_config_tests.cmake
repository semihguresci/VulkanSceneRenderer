cmake_minimum_required(VERSION 3.23)
if(NOT PROJECT_SOURCE_DIR_FOR_TEST OR NOT TEST_WORK_DIR)
    message(FATAL_ERROR "PROJECT_SOURCE_DIR_FOR_TEST and TEST_WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${TEST_WORK_DIR}/source" "${TEST_WORK_DIR}/config" "${TEST_WORK_DIR}/module")
file(WRITE "${TEST_WORK_DIR}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.23)
project(OpenVdbDependencyFixture LANGUAGES NONE)
set(CMAKE_FIND_USE_CMAKE_SYSTEM_PATH FALSE)
set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH FALSE)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY FALSE)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY FALSE)
include("${PROJECT_SOURCE_DIR_FOR_TEST}/cmake/OpenVdbDependencies.cmake")
if(NOT TARGET Dep_OpenVDB)
    message(FATAL_ERROR "Missing optional dependency interface")
endif()
get_target_property(definitions Dep_OpenVDB INTERFACE_COMPILE_DEFINITIONS)
get_target_property(libraries Dep_OpenVDB INTERFACE_LINK_LIBRARIES)
if(ENABLE_OPENVDB)
    if(NOT "CONTAINER_HAS_OPENVDB=1" IN_LIST definitions OR
       NOT "OpenVDB::openvdb" IN_LIST libraries)
        message(FATAL_ERROR "Enabled dependency does not propagate its target and definition")
    endif()
elseif(TARGET OpenVDB::openvdb OR definitions OR libraries)
    message(FATAL_ERROR "Disabled dependency still requires OpenVDB")
endif()
foreach(config IN ITEMS RELEASE DEBUG)
    if(EXPECTED_LIBRARY_${config})
        get_target_property(actual OpenVDB::openvdb IMPORTED_LOCATION_${config})
        if(NOT actual STREQUAL EXPECTED_LIBRARY_${config})
            message(FATAL_ERROR "${config} library: expected ${EXPECTED_LIBRARY_${config}}, got ${actual}")
        endif()
    endif()
endforeach()
if(EXPECT_NO_RUNTIME AND CONTAINER_OPENVDB_RUNTIME_DLL)
    message(FATAL_ERROR "Static OpenVDB unexpectedly stages a DLL")
endif()
if(CHECK_RUNTIME)
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/runtime-$<CONFIG>.txt"
        CONTENT "${CONTAINER_OPENVDB_RUNTIME_DLL}")
endif()
]=])
file(WRITE "${TEST_WORK_DIR}/config/OpenVDBConfig.cmake"
    "add_library(OpenVDB::openvdb INTERFACE IMPORTED)\nset(OpenVDB_VERSION 12.0.1)\n")
file(MAKE_DIRECTORY "${TEST_WORK_DIR}/module/lib/cmake/OpenVDB")
file(WRITE "${TEST_WORK_DIR}/module/lib/cmake/OpenVDB/FindOpenVDB.cmake"
    "add_library(OpenVDB::openvdb INTERFACE IMPORTED)\nset(OpenVDB_FOUND TRUE)\n")

function(check_config name enabled prefix succeeds)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        -S "${TEST_WORK_DIR}/source" -B "${TEST_WORK_DIR}/${name}"
        "-DENABLE_OPENVDB=${enabled}"
        "-DPROJECT_SOURCE_DIR_FOR_TEST=${PROJECT_SOURCE_DIR_FOR_TEST}"
        "-DCMAKE_PREFIX_PATH=${prefix}"
        "-DOpenVDB_ROOT=${prefix}"
        "-DCMAKE_MAKE_PROGRAM=${TEST_CMAKE_MAKE_PROGRAM}"
        -DCMAKE_BUILD_TYPE=Release
        ${ARGN}
        -G "${TEST_CMAKE_GENERATOR}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(succeeds AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name} failed:\n${output}\n${errors}")
    elseif(NOT succeeds)
        if(result EQUAL 0 OR NOT "${output}${errors}" MATCHES "ENABLE_OPENVDB=ON requires OpenVDB::openvdb")
            message(FATAL_ERROR "${name} did not report the missing dependency:\n${output}\n${errors}")
        endif()
    endif()
endfunction()

check_config(disabled OFF "${TEST_WORK_DIR}/absent" TRUE)
check_config(package_config ON "${TEST_WORK_DIR}/config" TRUE)
check_config(upstream_module ON "${TEST_WORK_DIR}/module" TRUE)
check_config(missing ON "${TEST_WORK_DIR}/absent" FALSE)

if(WIN32)
    # Empty files suffice for configuration: these tests verify imported target
    # selection and generator expressions without compiling or linking fixtures.
    set(prefix "${TEST_WORK_DIR}/windows-prefix")
    file(MAKE_DIRECTORY "${prefix}/lib" "${prefix}/bin" "${prefix}/debug/lib" "${prefix}/debug/bin")
    foreach(path IN ITEMS lib/openvdb.lib bin/openvdb.dll debug/lib/openvdb.lib debug/bin/openvdb.dll
        lib/openvdb_d.lib bin/openvdb_d.dll)
        file(WRITE "${prefix}/${path}" "fixture")
    endforeach()
    foreach(mode IN ITEMS release_first debug_first configured static static_debug_first postfix shared mapped)
        set(config_dir "${TEST_WORK_DIR}/${mode}-config")
        file(MAKE_DIRECTORY "${config_dir}")
        set(kind UNKNOWN)
        set(location "${prefix}/lib/openvdb.lib")
        set(debug_library "${prefix}/debug/lib/openvdb.lib")
        set(debug_runtime "${prefix}/debug/bin/openvdb.dll")
        if(mode STREQUAL "debug_first" OR mode STREQUAL "static_debug_first")
            set(location "${prefix}/debug/lib/openvdb.lib")
        elseif(mode STREQUAL "postfix")
            set(location "${prefix}/lib/openvdb_d.lib")
            set(debug_library "${prefix}/lib/openvdb_d.lib")
            set(debug_runtime "${prefix}/bin/openvdb_d.dll")
        endif()
        if(mode MATCHES "^static")
            set(kind STATIC)
        elseif(mode STREQUAL "shared")
            set(kind SHARED)
        endif()
        set(config_source "add_library(OpenVDB::openvdb ${kind} IMPORTED)\n")
        if(mode STREQUAL "configured")
            string(APPEND config_source
                "set_target_properties(OpenVDB::openvdb PROPERTIES IMPORTED_CONFIGURATIONS \"RELEASE;DEBUG\" IMPORTED_LOCATION_RELEASE \"${prefix}/lib/openvdb.lib\" IMPORTED_LOCATION_DEBUG \"${prefix}/debug/lib/openvdb.lib\")\n")
        elseif(mode STREQUAL "shared")
            string(APPEND config_source
                "set_target_properties(OpenVDB::openvdb PROPERTIES IMPORTED_CONFIGURATIONS \"RELEASE;DEBUG\" IMPORTED_LOCATION_RELEASE \"${prefix}/bin/openvdb.dll\" IMPORTED_LOCATION_DEBUG \"${prefix}/debug/bin/openvdb.dll\" IMPORTED_IMPLIB_RELEASE \"${prefix}/lib/openvdb.lib\" IMPORTED_IMPLIB_DEBUG \"${prefix}/debug/lib/openvdb.lib\")\n")
        else()
            string(APPEND config_source
                "set_property(TARGET OpenVDB::openvdb PROPERTY IMPORTED_LOCATION \"${location}\")\n")
        endif()
        if(mode STREQUAL "mapped")
            string(APPEND config_source "set_property(TARGET OpenVDB::openvdb PROPERTY MAP_IMPORTED_CONFIG_DEBUG RELEASE)\n")
            set(debug_runtime "${prefix}/bin/openvdb.dll")
        endif()
        file(WRITE "${config_dir}/OpenVDBConfig.cmake" "${config_source}")
        set(arguments "-DEXPECTED_LIBRARY_RELEASE=${prefix}/lib/openvdb.lib"
            "-DEXPECTED_LIBRARY_DEBUG=${debug_library}")
        if(mode STREQUAL "shared")
            set(arguments "-DEXPECTED_LIBRARY_RELEASE=${prefix}/bin/openvdb.dll"
                "-DEXPECTED_LIBRARY_DEBUG=${prefix}/debug/bin/openvdb.dll")
        endif()
        if(mode MATCHES "^static")
            list(APPEND arguments -DEXPECT_NO_RUNTIME=ON)
        else()
            list(APPEND arguments -DCHECK_RUNTIME=ON)
        endif()
        check_config("windows_${mode}" ON "${config_dir}" TRUE ${arguments})
        if(NOT mode MATCHES "^static")
            file(READ "${TEST_WORK_DIR}/windows_${mode}/runtime-Release.txt" runtime)
            cmake_path(NORMAL_PATH runtime)
            if(NOT runtime STREQUAL "${prefix}/bin/openvdb.dll")
                message(FATAL_ERROR "${mode}: incorrect Release runtime ${runtime}")
            endif()
            # Multi-config generators emit both; single-config Debug gets its
            # own configure to prove the Debug-first dependency layout.
            if(NOT EXISTS "${TEST_WORK_DIR}/windows_${mode}/runtime-Debug.txt")
                check_config("windows_${mode}" ON "${config_dir}" TRUE ${arguments} -DCMAKE_BUILD_TYPE=Debug)
            endif()
            file(READ "${TEST_WORK_DIR}/windows_${mode}/runtime-Debug.txt" runtime)
            cmake_path(NORMAL_PATH runtime)
            if(NOT runtime STREQUAL debug_runtime)
                message(FATAL_ERROR "${mode}: incorrect Debug runtime ${runtime}")
            endif()
        endif()
    endforeach()
endif()
message(STATUS "OpenVDB dependency configuration checks passed")
