cmake_minimum_required(VERSION 3.23)
if(NOT PROJECT_SOURCE_DIR_FOR_TEST OR NOT TEST_WORK_DIR)
    message(FATAL_ERROR "PROJECT_SOURCE_DIR_FOR_TEST and TEST_WORK_DIR are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_WORK_DIR "${TEST_WORK_DIR}/run-${run_id}")
file(TO_CMAKE_PATH "${TEST_WORK_DIR}" TEST_WORK_DIR)
set(module "${PROJECT_SOURCE_DIR_FOR_TEST}/cmake/VulkanLoaderRuntime.cmake")
file(TO_CMAKE_PATH "${module}" module)
set(cases disabled missing-dll missing-notice wrong-pin)
if(TEST_VULKAN_LOADER_ROOT AND WIN32)
    list(APPEND cases pinned wrong-notice)
endif()
foreach(case_name IN LISTS cases)
    set(case_root "${TEST_WORK_DIR}/${case_name}")
    set(loader "${case_root}/loader")
    file(MAKE_DIRECTORY "${case_root}/fixture" "${loader}")
    set(expected_error "")
    if(case_name STREQUAL "missing-dll")
        set(expected_error "Pinned Vulkan loader file is missing")
    elseif(case_name STREQUAL "missing-notice")
        file(WRITE "${loader}/vulkan-1.dll" "Invalid negative-test DLL, not a runtime")
        set(expected_error "VulkanRT-License.txt")
    elseif(case_name STREQUAL "wrong-pin")
        file(WRITE "${loader}/vulkan-1.dll" "Invalid negative-test DLL, not a runtime")
        file(WRITE "${loader}/VulkanRT-License.txt" "Invalid negative-test notice")
        set(expected_error "outside the signed Windows x64 1.4.363.0 pin")
    elseif(case_name STREQUAL "pinned" OR case_name STREQUAL "wrong-notice")
        # Positive inputs are supplied explicitly, never downloaded or mocked.
        file(COPY_FILE "${TEST_VULKAN_LOADER_ROOT}/vulkan-1.dll" "${loader}/vulkan-1.dll")
        file(COPY_FILE "${TEST_VULKAN_LOADER_ROOT}/VulkanRT-License.txt" "${loader}/VulkanRT-License.txt")
        if(case_name STREQUAL "wrong-notice")
            file(APPEND "${loader}/VulkanRT-License.txt" "Corrupted negative-test notice")
            set(expected_error "license is outside the 1.4.363.0 pin")
        endif()
    endif()
    if(case_name STREQUAL "disabled")
        set(selected_root "")
    else()
        set(selected_root "${loader}")
    endif()
    if(NOT WIN32 AND NOT case_name STREQUAL "disabled")
        set(expected_error "requires a Windows x64 build")
    endif()
    file(WRITE "${case_root}/fixture/CMakeLists.txt"
        "cmake_minimum_required(VERSION 3.23)\nproject(LoaderFixture LANGUAGES NONE)\n"
        "set(CMAKE_SIZEOF_VOID_P 8)\n"
        "set(CONTAINER_VULKAN_LOADER_ROOT [==[${selected_root}]==] CACHE PATH \"\")\n"
        "include([==[${module}]==])\n"
        "file(WRITE \"\${CMAKE_BINARY_DIR}/available.txt\" \"\${CONTAINER_VULKAN_LOADER_AVAILABLE}\")\n")
    set(command "${CMAKE_COMMAND}" -S "${case_root}/fixture" -B "${case_root}/build")
    if(TEST_CMAKE_GENERATOR)
        list(APPEND command -G "${TEST_CMAKE_GENERATOR}")
    endif()
    if(TEST_CMAKE_MAKE_PROGRAM)
        list(APPEND command "-DCMAKE_MAKE_PROGRAM:FILEPATH=${TEST_CMAKE_MAKE_PROGRAM}")
    endif()
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(WRITE "${case_root}/configure.log" "${output}\n${errors}")
    if(expected_error)
        string(FIND "${output}\n${errors}" "${expected_error}" position)
        if(result EQUAL 0 OR position EQUAL -1)
            message(FATAL_ERROR "${case_name} did not reject the expected input: ${output}\n${errors}")
        endif()
        if(EXISTS "${case_root}/build/third_party_licenses/VulkanRT-License.txt")
            message(FATAL_ERROR "Rejected input staged a notice")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${case_name} failed: ${output}\n${errors}")
    elseif(case_name STREQUAL "disabled")
        file(READ "${case_root}/build/available.txt" available)
        if(NOT available STREQUAL "OFF" OR EXISTS "${case_root}/build/third_party_licenses")
            message(FATAL_ERROR "Unselected loader changed ordinary development configuration")
        endif()
    else()
        file(READ "${case_root}/build/available.txt" available)
        if(NOT available STREQUAL "ON")
            message(FATAL_ERROR "Pinned loader was not recorded")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}"
            "-DCONTAINER_VULKAN_LOADER_ROOT=${loader}"
            "-DCONTAINER_VULKAN_LOADER_STAGE_DESTINATION=${case_root}/staged"
            -P "${module}" RESULT_VARIABLE stage_result OUTPUT_VARIABLE stage_output ERROR_VARIABLE stage_errors)
        if(NOT stage_result EQUAL 0)
            message(FATAL_ERROR "Pinned staging failed: ${stage_output}\n${stage_errors}")
        endif()
        foreach(name IN ITEMS vulkan-1.dll VulkanRT-License.txt)
            if(name STREQUAL "vulkan-1.dll")
                set(destination "${case_root}/staged/${name}")
            else()
                set(destination "${case_root}/staged/third_party_licenses/${name}")
            endif()
            file(SHA256 "${loader}/${name}" original)
            file(SHA256 "${destination}" staged)
            if(NOT original STREQUAL staged)
                message(FATAL_ERROR "Staged input changed: ${name}")
            endif()
        endforeach()
        file(APPEND "${loader}/vulkan-1.dll" "Corrupt after configure")
        execute_process(COMMAND "${CMAKE_COMMAND}"
            "-DCONTAINER_VULKAN_LOADER_ROOT=${loader}"
            "-DCONTAINER_VULKAN_LOADER_STAGE_DESTINATION=${case_root}/rejected-stage"
            -P "${module}" RESULT_VARIABLE stale_result OUTPUT_VARIABLE stale_output ERROR_VARIABLE stale_errors)
        string(FIND "${stale_output}\n${stale_errors}" "outside the signed Windows x64 1.4.363.0 pin" stale_position)
        if(stale_result EQUAL 0 OR stale_position EQUAL -1 OR EXISTS "${case_root}/rejected-stage")
            message(FATAL_ERROR "Staging did not reject a runtime changed after configuration")
        endif()
    endif()
    message(STATUS "PASS Vulkan loader ${case_name}")
endforeach()
if(NOT TEST_VULKAN_LOADER_ROOT)
    message(STATUS "Pinned positive/staging cases require TEST_VULKAN_LOADER_ROOT; no download performed")
endif()
