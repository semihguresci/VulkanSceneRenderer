include_guard(GLOBAL)

option(ENABLE_TEXTURE_KTX "Decode Basis Universal and supercompressed KTX2 textures" OFF)
option(ENABLE_TEXTURE_WEBP "Decode static WebP material textures" OFF)
option(CONTAINER_FETCH_TEXTURE_CODECS "Fetch pinned missing texture codecs" OFF)
set(CONTAINER_TEXTURE_KTX_LICENSE_FILE "" CACHE FILEPATH "Aggregate upstream notices for a package-provided libktx")
set(CONTAINER_TEXTURE_WEBP_LICENSE_FILE "" CACHE FILEPATH "Aggregate upstream notices for a package-provided libwebp")

add_library(Dep_TextureCodecs INTERFACE)
if(NOT ENABLE_TEXTURE_KTX AND NOT ENABLE_TEXTURE_WEBP)
    return()
endif()
include(FetchContent)

function(container_stage_texture_notice dependency package_dir override_file)
    if(override_file)
        if(NOT EXISTS "${override_file}" OR IS_DIRECTORY "${override_file}")
            message(FATAL_ERROR "${dependency} notice override is not a file: ${override_file}")
        endif()
        set(notice "${override_file}")
    else()
        find_file(notice NAMES copyright LICENSE.md LICENSE COPYING
            PATHS "${package_dir}" "${package_dir}/../../../share/${dependency}"
            NO_DEFAULT_PATH NO_CACHE)
        if(NOT notice)
            message(FATAL_ERROR "${dependency} package does not expose aggregate upstream notices. Set CONTAINER_TEXTURE_${dependency}_LICENSE_FILE.")
        endif()
    endif()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/third_party_licenses")
    configure_file("${notice}" "${CMAKE_BINARY_DIR}/third_party_licenses/${dependency}-package-notices.txt" COPYONLY)
endfunction()

function(container_fetch_texture_ktx)
    cmake_policy(SET CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(BUILD_SHARED_LIBS OFF)
    set(KTX_FEATURE_DOC OFF)
    set(KTX_FEATURE_JNI OFF)
    set(KTX_FEATURE_PY OFF)
    set(KTX_FEATURE_TESTS OFF)
    set(KTX_FEATURE_TOOLS OFF)
    set(KTX_FEATURE_TOOLS_CTS OFF)
    set(KTX_FEATURE_LOADTEST_APPS OFF)
    set(KTX_FEATURE_GL_UPLOAD OFF)
    set(KTX_FEATURE_VK_UPLOAD OFF)
    # Exclude the restricted Ericsson ETC software decoder. Basis transcoding
    # uses the separately licensed Basis Universal implementation.
    set(KTX_FEATURE_ETC_UNPACK OFF)
    set(KTX_WERROR OFF)
    set(BASISU_SUPPORT_OPENCL OFF)
    set(ASTCENC_ISA_NONE ON)
    FetchContent_Declare(container_texture_ktx
        URL https://codeload.github.com/KhronosGroup/KTX-Software/zip/4d6fc70eaf62ad0558e63e8d97eb9766118327a6
        URL_HASH SHA256=f75dc5b787189e1cf4473560448628e38eba945ebeed05cbf1d817ef895448fa)
    FetchContent_MakeAvailable(container_texture_ktx)
    # Upstream defines encoder and decoder targets together. Only ktx_read is
    # part of this dependency, so keep the encoder out of the default build.
    set_property(TARGET ktx PROPERTY EXCLUDE_FROM_ALL TRUE)
    if(TARGET objUtil)
        set_property(TARGET objUtil PROPERTY EXCLUDE_FROM_ALL TRUE)
    endif()
    add_library(ContainerTextureKtx ALIAS ktx_read)
    set(container_texture_ktx_FETCHED TRUE PARENT_SCOPE)
    set(notices "${CMAKE_BINARY_DIR}/third_party_licenses/KTX")
    file(MAKE_DIRECTORY "${notices}")
    configure_file("${container_texture_ktx_SOURCE_DIR}/LICENSE.md" "${notices}/LICENSE.md" COPYONLY)
    configure_file("${container_texture_ktx_SOURCE_DIR}/NOTICE.md" "${notices}/NOTICE.md" COPYONLY)
    configure_file("${container_texture_ktx_SOURCE_DIR}/REUSE.toml" "${notices}/REUSE.toml" COPYONLY)
    file(COPY "${container_texture_ktx_SOURCE_DIR}/LICENSES" DESTINATION "${notices}")
    foreach(entry external/basisu/LICENSE external/basisu/zstd/LICENSE external/dfdutils/LICENSE.adoc)
        string(REPLACE "/" "-" notice_name "${entry}")
        configure_file("${container_texture_ktx_SOURCE_DIR}/${entry}" "${notices}/${notice_name}" COPYONLY)
    endforeach()
    # uthash's copyright and BSD-1-Clause notice live in its public header.
    file(STRINGS "${container_texture_ktx_SOURCE_DIR}/lib/uthash.h" uthash_notice LIMIT_COUNT 4)
    string(REPLACE ";" "\n" uthash_notice "${uthash_notice}")
    file(WRITE "${notices}/uthash-notice.txt" "${uthash_notice}\n")
endfunction()

function(container_fetch_texture_webp)
    cmake_policy(SET CMP0077 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(BUILD_SHARED_LIBS OFF)
    foreach(feature ANIM_UTILS CWEBP DWEBP GIF2WEBP IMG2WEBP VWEBP WEBPINFO LIBWEBPMUX WEBPMUX EXTRAS WEBP_JS FUZZTEST)
        set(WEBP_BUILD_${feature} OFF)
    endforeach()
    FetchContent_Declare(container_texture_webp
        URL https://codeload.github.com/webmproject/libwebp/zip/4fa21912338357f89e4fd51cf2368325b59e9bd9
        URL_HASH SHA256=a1e18776b2bfdf59db4089cefb7453d3207bb6e77c24d649e0757e3a08fdca14)
    FetchContent_MakeAvailable(container_texture_webp)
    foreach(target webp webpencode webpdsp webputils webpdemux sharpyuv)
        if(TARGET ${target})
            set_property(TARGET ${target} PROPERTY EXCLUDE_FROM_ALL TRUE)
        endif()
    endforeach()
    add_library(ContainerTextureWebp ALIAS webpdecoder)
    # Upstream's build interface is its project root; its public headers are in
    # src/webp before installation, rather than the installed webp/ directory.
    target_include_directories(webpdecoder INTERFACE "$<BUILD_INTERFACE:${container_texture_webp_SOURCE_DIR}/src>")
    set(container_texture_webp_FETCHED TRUE PARENT_SCOPE)
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/third_party_licenses")
    foreach(notice COPYING PATENTS)
        configure_file("${container_texture_webp_SOURCE_DIR}/${notice}"
            "${CMAKE_BINARY_DIR}/third_party_licenses/WebP-${notice}.txt" COPYONLY)
    endforeach()
endfunction()

if(ENABLE_TEXTURE_KTX)
    find_package(Ktx 4.4.2 CONFIG QUIET)
    if(TARGET KTX::ktx_read)
        add_library(ContainerTextureKtx ALIAS KTX::ktx_read)
    elseif(TARGET KTX::ktx)
        add_library(ContainerTextureKtx ALIAS KTX::ktx)
    elseif(CONTAINER_FETCH_TEXTURE_CODECS)
        container_fetch_texture_ktx()
    endif()
    if(NOT TARGET ContainerTextureKtx)
        message(FATAL_ERROR "ENABLE_TEXTURE_KTX requires libktx>=4.4.2. Set Ktx_DIR/CMAKE_PREFIX_PATH or explicitly enable CONTAINER_FETCH_TEXTURE_CODECS.")
    endif()
    if(NOT container_texture_ktx_FETCHED)
        container_stage_texture_notice(KTX "${Ktx_DIR}" "${CONTAINER_TEXTURE_KTX_LICENSE_FILE}")
    endif()
    target_link_libraries(Dep_TextureCodecs INTERFACE ContainerTextureKtx)
    target_compile_definitions(Dep_TextureCodecs INTERFACE CONTAINER_HAS_KTX=1)
endif()

if(ENABLE_TEXTURE_WEBP)
    find_package(WebP 1.6 CONFIG QUIET)
    if(TARGET WebP::webpdecoder)
        add_library(ContainerTextureWebp ALIAS WebP::webpdecoder)
    elseif(TARGET WebP::webp)
        add_library(ContainerTextureWebp ALIAS WebP::webp)
    elseif(CONTAINER_FETCH_TEXTURE_CODECS)
        container_fetch_texture_webp()
    endif()
    if(NOT TARGET ContainerTextureWebp)
        message(FATAL_ERROR "ENABLE_TEXTURE_WEBP requires libwebp. Set WebP_DIR/CMAKE_PREFIX_PATH or explicitly enable CONTAINER_FETCH_TEXTURE_CODECS.")
    endif()
    if(NOT container_texture_webp_FETCHED)
        container_stage_texture_notice(WEBP "${WebP_DIR}" "${CONTAINER_TEXTURE_WEBP_LICENSE_FILE}")
    endif()
    target_link_libraries(Dep_TextureCodecs INTERFACE ContainerTextureWebp)
    target_compile_definitions(Dep_TextureCodecs INTERFACE CONTAINER_HAS_WEBP=1)
endif()
