set(CONTAINER_VK_OIDN_AVAILABLE OFF CACHE INTERNAL "vk_oidn backend was built" FORCE)
if(ENABLE_REFERENCE_OIDN)
    find_package(vk_oidn 0.2.0 EXACT CONFIG QUIET)
    if(TARGET vk_oidn::vk_oidn)
        get_filename_component(_oidn_sdk "${vk_oidn_DIR}/../../.." ABSOLUTE)
        foreach(_notice LICENSE NOTICE)
            if(NOT EXISTS "${_oidn_sdk}/${_notice}")
                message(FATAL_ERROR "The vk_oidn SDK must include ${_notice} for redistribution")
            endif()
            configure_file("${_oidn_sdk}/${_notice}"
                "${CMAKE_BINARY_DIR}/third_party_licenses/vk_oidn-${_notice}.txt" COPYONLY)
        endforeach()
        set(CONTAINER_VK_OIDN_AVAILABLE ON CACHE INTERNAL "vk_oidn backend was built" FORCE)
    else()
        message(WARNING "vk_oidn 0.2.0 SDK unavailable. Set vk_oidn_DIR to its lib/cmake/vk_oidn directory. Reference rendering remains available.")
    endif()
endif()
