# Slang emits a Make-style dependency line with escaped spaces, colons and
# backslashes. Retain compiler order and use contents instead of timestamps.
function(shader_dependency_fingerprint depfile original_root current_root result)
    set(${result} "" PARENT_SCOPE)
    if(NOT EXISTS "${depfile}")
        return()
    endif()
    file(READ "${depfile}" line)
    string(FIND "${line}" ": " separator)
    if(separator EQUAL -1)
        return()
    endif()
    math(EXPR start "${separator} + 2")
    string(SUBSTRING "${line}" ${start} -1 dependencies)
    string(REGEX REPLACE "\\\\[\r\n]+" " " dependencies "${dependencies}")
    string(REGEX MATCHALL "([^ \t\r\n\\\\]|\\\\.)+" paths "${dependencies}")
    set(hashes "")
    foreach(encoded IN LISTS paths)
        string(REGEX REPLACE "\\\\(.)" "\\1" path "${encoded}")
        cmake_path(IS_PREFIX original_root "${path}" NORMALIZE inside_source)
        if(inside_source)
            cmake_path(RELATIVE_PATH path BASE_DIRECTORY "${original_root}" OUTPUT_VARIABLE relative)
            set(path "${current_root}/${relative}")
        endif()
        if(NOT EXISTS "${path}")
            return()
        endif()
        file(SHA256 "${path}" hash)
        string(APPEND hashes "${hash}")
    endforeach()
    if(hashes)
        string(SHA256 fingerprint "${hashes}")
        set(${result} "${fingerprint}" PARENT_SCOPE)
    endif()
endfunction()

if(DEFINED FINGERPRINT_OUTPUT)
    cmake_minimum_required(VERSION 3.23)
    shader_dependency_fingerprint("${DEPFILE}" "${SOURCE_ROOT}" "${SOURCE_ROOT}" fingerprint)
    file(WRITE "${FINGERPRINT_OUTPUT}" "${fingerprint}")
endif()
