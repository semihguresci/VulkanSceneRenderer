function(shader_dependency_path path original_root current_root result)
    if(WIN32)
        string(REPLACE "\\" "/" path "${path}")
    endif()
    cmake_path(IS_PREFIX original_root "${path}" NORMALIZE inside_source)
    if(inside_source)
        cmake_path(RELATIVE_PATH path BASE_DIRECTORY "${original_root}" OUTPUT_VARIABLE relative)
        set(path "${current_root}/${relative}")
    endif()
    set(${result} "${path}" PARENT_SCOPE)
endfunction()

# Slang emits a Make-style dependency line with escaped spaces, colons and
# backslashes. Retain compiler order and use contents instead of timestamps.
function(shader_dependency_fingerprint depfile original_root current_root result)
    set(${result} "" PARENT_SCOPE)
    if(NOT EXISTS "${depfile}")
        return()
    endif()
    file(READ "${depfile}" line)
    string(FIND "${line}" ": " separator)
    if(separator EQUAL -1)
        return()
    endif()
    math(EXPR start "${separator} + 2")
    string(SUBSTRING "${line}" ${start} -1 dependencies)
    string(REGEX REPLACE "\\\\[\r\n]+" " " dependencies "${dependencies}")
    string(REGEX MATCHALL "([^ \t\r\n\\\\]|\\\\.)+" paths "${dependencies}")
    set(hashes "")
    foreach(encoded IN LISTS paths)
        string(REGEX REPLACE "\\\\(.)" "\\1" path "${encoded}")
        shader_dependency_path("${path}" "${original_root}" "${current_root}" path)
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            return()
        endif()
        file(SHA256 "${path}" hash)
        string(APPEND hashes "${hash}")
    endforeach()
    if(hashes)
        string(SHA256 fingerprint "${hashes}")
        set(${result} "${fingerprint}" PARENT_SCOPE)
    endif()
endfunction()

# The repro contains compiler-read bytes and the lookup paths Slang tried.
# The depfile alone omits both absent candidates and rejected module files.
function(shader_read_lookup_paths manifest result)
    set(${result} "" PARENT_SCOPE)
    file(STRINGS "${manifest}" lines ENCODING UTF-8)
    cmake_path(GET manifest PARENT_PATH directory)
    set(section "")
    set(lookups "slang-lookup-v2\n")
    foreach(line IN LISTS lines)
        if(line STREQUAL "[files]" OR line STREQUAL "[paths]")
            set(section "${line}")
            continue()
        endif()
        if(NOT section)
            continue()
        endif()
        if(NOT line MATCHES "^(.+) -> (.+)$")
            return()
        endif()
        if(section STREQUAL "[files]")
            set(alias "${CMAKE_MATCH_1}")
            set(path "${CMAKE_MATCH_2}")
        else()
            set(path "${CMAKE_MATCH_1}")
            set(alias "${CMAKE_MATCH_2}")
        endif()
        if(WIN32)
            string(REPLACE "\\" "/" path "${path}")
        endif()
        cmake_path(IS_ABSOLUTE path absolute)
        if(NOT absolute)
            return()
        endif()
        set(archived "${directory}/${alias}")
        cmake_path(IS_PREFIX directory "${archived}" NORMALIZE inside_archive)
        if(inside_archive AND EXISTS "${archived}" AND NOT IS_DIRECTORY "${archived}")
            file(SHA256 "${archived}" hash)
            string(APPEND lookups "${hash} ${path}\n")
        elseif(section STREQUAL "[paths]" AND
               alias MATCHES "^(directory *|file( \\[cannot open\\])?|\\[(not found|not loaded|cannot open|fail)\\])$")
            string(APPEND lookups "- ${path}\n")
        else()
            return()
        endif()
    endforeach()
    if(section STREQUAL "[paths]")
        set(${result} "${lookups}" PARENT_SCOPE)
    endif()
endfunction()

function(shader_write_lookup_paths compiler repro output)
    file(WRITE "${output}" "unavailable\n")
    if(NOT EXISTS "${repro}")
        message(STATUS "Slang did not record lookups for ${output}")
        return()
    endif()
    cmake_path(GET output PARENT_PATH parent)
    cmake_path(GET repro STEM LAST_ONLY stage)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
    set(scratch "${parent}/lookup-${stage}-${suffix}")
    file(MAKE_DIRECTORY "${scratch}")
    file(REAL_PATH "${parent}" parent)
    file(REAL_PATH "${scratch}" resolved_scratch)
    cmake_path(GET resolved_scratch PARENT_PATH resolved_parent)
    if(NOT resolved_parent STREQUAL parent OR IS_SYMLINK "${scratch}")
        message(FATAL_ERROR "Invalid shader lookup scratch directory")
    endif()

    set(archive "${scratch}/capture.slang-repro")
    file(RENAME "${repro}" "${archive}")
    execute_process(COMMAND "${compiler}" -extract-repro "${archive}"
                    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE diagnostics)
    set(manifest "${scratch}/capture/manifest.txt")
    if(status STREQUAL "0" AND EXISTS "${manifest}")
        shader_read_lookup_paths("${manifest}" lookups)
        if(lookups)
            file(WRITE "${output}" "${lookups}")
        else()
            message(STATUS "Unrecognized Slang lookup manifest for ${stage}")
        endif()
    else()
        message(STATUS "Could not extract Slang lookup manifest for ${stage} (${status}) ${diagnostics}")
    endif()
    file(REMOVE_RECURSE "${resolved_scratch}")
endfunction()

function(shader_lookup_paths_unchanged metadata original_root current_root result)
    set(${result} FALSE PARENT_SCOPE)
    if(NOT EXISTS "${metadata}" OR IS_DIRECTORY "${metadata}")
        return()
    endif()
    file(STRINGS "${metadata}" paths ENCODING UTF-8)
    if(NOT paths)
        return()
    endif()
    list(POP_FRONT paths version)
    if(NOT version STREQUAL "slang-lookup-v2" OR NOT paths)
        return()
    endif()
    foreach(record IN LISTS paths)
        if(NOT record MATCHES "^(-|[0-9a-f]+) (.+)$")
            return()
        endif()
        set(expected "${CMAKE_MATCH_1}")
        set(path "${CMAKE_MATCH_2}")
        cmake_path(IS_ABSOLUTE path absolute)
        if(NOT absolute)
            return()
        endif()
        shader_dependency_path("${path}" "${original_root}" "${current_root}" path)
        if(expected STREQUAL "-")
            if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
                return()
            endif()
        elseif(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            return()
        else()
            file(SHA256 "${path}" actual)
            if(NOT actual STREQUAL expected)
                return()
            endif()
        endif()
    endforeach()
    set(${result} TRUE PARENT_SCOPE)
endfunction()

if(DEFINED FINGERPRINT_OUTPUT OR DEFINED LOOKUP_OUTPUT)
    cmake_minimum_required(VERSION 3.23)
endif()
if(DEFINED DEPFILE_TARGET)
    file(READ "${DEPFILE}" line)
    string(FIND "${line}" ": " separator)
    if(separator EQUAL -1)
        message(FATAL_ERROR "Invalid Slang depfile ${DEPFILE}")
    endif()
    string(SUBSTRING "${line}" ${separator} -1 dependencies)
    string(REPLACE " " "\\ " target "${DEPFILE_TARGET}")
    file(WRITE "${DEPFILE}" "${target}${dependencies}")
endif()
if(DEFINED FINGERPRINT_OUTPUT)
    shader_dependency_fingerprint("${DEPFILE}" "${SOURCE_ROOT}" "${SOURCE_ROOT}" fingerprint)
    file(WRITE "${FINGERPRINT_OUTPUT}" "${fingerprint}")
endif()
if(DEFINED LOOKUP_OUTPUT)
    shader_write_lookup_paths("${SLANGC}" "${LOOKUP_REPRO}" "${LOOKUP_OUTPUT}")
endif()
