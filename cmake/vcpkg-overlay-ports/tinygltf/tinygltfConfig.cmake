get_filename_component(_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json CONFIG REQUIRED)
if(NOT TARGET tinygltf::tinygltf)
  add_library(tinygltf::tinygltf INTERFACE IMPORTED)
  set_target_properties(tinygltf::tinygltf PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_prefix}/include")
endif()
set(tinygltf_FOUND TRUE)
set(tinygltf_VERSION "3.1.0")
set(CONTAINER_TINYGLTF_RELEASE_VERSION "3.1.0")
set(CONTAINER_TINYGLTF_COMPATIBILITY_API "legacy-cpp-deprecated (header family 2.9.*)")
set(TINYGLTF_INCLUDE_DIRS "${_prefix}/include")
set_property(TARGET tinygltf::tinygltf PROPERTY INTERFACE_LINK_LIBRARIES nlohmann_json::nlohmann_json)
