get_filename_component(_prefix "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include(CMakeFindDependencyMacro)
find_dependency(miniz CONFIG REQUIRED)
if(NOT TARGET tinyexr::tinyexr)
  add_library(tinyexr::tinyexr INTERFACE IMPORTED)
  set_target_properties(tinyexr::tinyexr PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_prefix}/include")
endif()
set(tinyexr_FOUND TRUE)
set(tinyexr_VERSION "3.4.0")
set(CONTAINER_TINYEXR_RELEASE_VERSION "3.4.0")
set(CONTAINER_TINYEXR_COMPATIBILITY_API "legacy-cpp-v1 (official root CMake interface)")
set(TINYEXR_INCLUDE_DIRS "${_prefix}/include")
set_property(TARGET tinyexr::tinyexr PROPERTY INTERFACE_LINK_LIBRARIES miniz::miniz)
