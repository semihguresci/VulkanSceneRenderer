# Exact official latest-release C++ compatibility payloads. TinyGLTF attic is
# deprecated upstream; selecting these bytes does not claim the active C11 API.
include_guard(GLOBAL)
find_package(tinygltf 3.1.0 EXACT CONFIG REQUIRED)
find_package(tinyexr 3.4.0 EXACT CONFIG REQUIRED)
find_package(miniz 3.1.2 EXACT CONFIG REQUIRED)
function(container_tiny_root target header result)
  get_target_property(paths "${target}" INTERFACE_INCLUDE_DIRECTORIES)
  foreach(path IN LISTS paths)
    if(EXISTS "${path}/${header}")
      get_filename_component(root "${path}/.." ABSOLUTE)
      set(${result} "${root}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Selected ${target} has no ${header}")
endfunction()
container_tiny_root(tinygltf::tinygltf tiny_gltf.h _tg_prefix)
container_tiny_root(tinyexr::tinyexr tinyexr.h _te_prefix)
set(TINYGLTF_INCLUDE_DIRS "${_tg_prefix}/include")
set(TINYEXR_INCLUDE_DIRS "${_te_prefix}/include")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/third_party_licenses")
