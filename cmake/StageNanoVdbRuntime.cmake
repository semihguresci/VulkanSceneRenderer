if(NOT SEED_DLLS_FILE OR NOT EXISTS "${SEED_DLLS_FILE}")
    message(FATAL_ERROR "NanoVDB runtime staging requires a configured provider manifest")
endif()
file(STRINGS "${SEED_DLLS_FILE}" seed_dlls)
foreach(seed IN LISTS seed_dlls)
    if(seed STREQUAL "")
        continue()
    endif()
    set(OPENVDB_DLL "${seed}")
    set(RUNTIME_LABEL "NanoVDB codec")
    include("${CMAKE_CURRENT_LIST_DIR}/StageOpenVdbRuntime.cmake")
endforeach()
