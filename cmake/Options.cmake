option(ENABLE_TESTS "Enable building and running tests" ON)
option(ENABLE_RENDERER_MCP "Build the local renderer MCP endpoint" ON)
option(ENABLE_REFERENCE_OIDN "Build optional reference denoising with the vk_oidn 0.2.0 SDK" OFF)
option(ENABLE_REFERENCE_OPTIX "Build optional reference denoising with NVIDIA OptiX 9.1" OFF)
option(ENABLE_FSR_UPSCALING "Build optional Vulkan FSR upscaling with AMD FSR SDK 2.4.0" OFF)
option(ENABLE_DLSS_UPSCALING "Build the optional NVIDIA DLSS Super Resolution 310.9.16 backend" OFF)
option(ENABLE_DLSS_RAY_RECONSTRUCTION "Build the optional NVIDIA DLSS Ray Reconstruction 310.9.16 backend" OFF)
option(ENABLE_OPENVDB "Build OpenVDB volume import, rendering and voxel/SDF tools" OFF)
option(ENABLE_NANOVDB "Enable portable native sparse NanoVDB rendering when OpenVDB is enabled" ON)
option(ENABLE_NANOVDB_IO "Enable portable NanoVDB file tools independently of OpenVDB" ${ENABLE_OPENVDB})
option(ENABLE_NANOVDB_ZIP "Use an available zlib provider for NanoVDB file tools" ON)
option(ENABLE_NANOVDB_BLOSC "Use an available Blosc provider for NanoVDB file tools" ON)
option(ENABLE_PHYSICS "Build Jolt CPU rigid-body simulation and scene controls" ON)
option(ENABLE_GLTF_DRACO "Decode Draco glTF geometry in a bounded worker" OFF)
option(ENABLE_GLTF_MESHOPT "Decode KHR/EXT meshopt glTF buffer views" OFF)
option(CONTAINER_FETCH_GLTF_COMPRESSION "Fetch pinned missing glTF decoder dependencies" OFF)
option(ENABLE_TEXTURE_KTX "Decode Basis Universal and supercompressed KTX2 textures" OFF)
option(ENABLE_TEXTURE_WEBP "Decode static WebP material textures" OFF)
option(CONTAINER_FETCH_TEXTURE_CODECS "Fetch pinned missing texture codecs" OFF)
option(ENABLE_BIM_FRAME_CACHE_BENCHMARK "Build the opt-in BIM CPU cache benchmark" OFF)
option(ENABLE_SCENE_BROWSER_BENCHMARK "Build the opt-in real ImGui scene browser benchmark" OFF)
set(CONTAINER_BIM_CACHE_BASELINE_INCLUDE_DIR "" CACHE PATH
    "Optional captured provider headers for a before/after BIM cache benchmark")
option(ENABLE_WINDOWED_TESTS "Build tests that require a Vulkan runtime and display" OFF)
option(ENABLE_VULKAN_VALIDATION_LAYERS "Enable Vulkan Validation Layers" ON)
option(ENABLE_SAMPLE_MODEL_DOWNLOAD "Download pinned glTF Sample Models during asset generation" ON)
set(GLTF_SAMPLE_MODELS_DOWNLOAD_TIMEOUT_SECONDS "900" CACHE STRING
    "Total timeout, in seconds, for downloading the pinned glTF Sample Models archive")
set(GLTF_SAMPLE_MODELS_INACTIVITY_TIMEOUT_SECONDS "60" CACHE STRING
    "Inactivity timeout, in seconds, for downloading the pinned glTF Sample Models archive")
option(ENABLE_BIM_SAMPLE_MODEL_DOWNLOAD "Download latest buildingSMART IFC5-development files during asset generation" ON)
option(ENABLE_USD_SAMPLE_MODEL_DOWNLOAD "Download OpenUSD sample model archives during asset generation" ON)
option(ENABLE_TINYUSDZ_USD_LOADER "Build the TinyUSDZ-backed USD/USDZ importer" ON)
