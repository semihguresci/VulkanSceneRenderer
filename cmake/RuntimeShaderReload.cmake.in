cmake_minimum_required(VERSION 3.23)
if(NOT IS_DIRECTORY "${RELOAD_DIRECTORY}")
    message(FATAL_ERROR "A candidate shader directory is required")
endif()
set(compiler [==[@SLANGC_EXECUTABLE@]==])
set(flags [==[@SLANG_SPIRV_FLAGS@]==])
set(interfaces [==[@RELOAD_INTERFACE_DIR@]==])
set(baseline_spirv [==[@COMPILED_SHADERS_DIR@]==])
set(baseline_source [==[@CMAKE_SOURCE_DIR@]==])
set(source_root [==[@CMAKE_SOURCE_DIR@]==])
include([==[@CMAKE_CURRENT_LIST_DIR@/ShaderDependencies.cmake]==])
set(log "${RELOAD_DIRECTORY}/diagnostics.txt")
file(WRITE "${log}" "")
file(WRITE "${RELOAD_DIRECTORY}/compiled.txt" "")
file(MAKE_DIRECTORY "${RELOAD_DIRECTORY}/spv_shaders")

function(compile_reload_shader source entry output)
    set(candidate "${RELOAD_DIRECTORY}/spv_shaders/${output}")
    set(reflection "${RELOAD_DIRECTORY}/${output}.json")
    set(depfile "${interfaces}/${output}.d")
    if(EXISTS "${depfile}.sha256" AND EXISTS "${baseline_spirv}/${output}")
        file(READ "${depfile}.sha256" baseline_fingerprint)
        shader_dependency_fingerprint("${depfile}" "${baseline_source}" "${source_root}" fingerprint)
        if(fingerprint AND fingerprint STREQUAL baseline_fingerprint)
            shader_lookup_paths_unchanged("${depfile}.lookups" "${baseline_source}" "${source_root}" lookups_unchanged)
            if(lookups_unchanged)
                file(COPY_FILE "${baseline_spirv}/${output}" "${candidate}")
                return()
            endif()
        endif()
    endif()
    file(WRITE "${RELOAD_DIRECTORY}/current-stage.txt" "${output} (${entry})")
    execute_process(
        COMMAND "${compiler}" "${source}" ${flags} ${ARGN}
            -entry "${entry}" -o "${candidate}"
            -depfile "${RELOAD_DIRECTORY}/${output}.d"
            -reflection-json "${reflection}"
        RESULT_VARIABLE status OUTPUT_VARIABLE compiler_output ERROR_VARIABLE compiler_error)
    if(NOT status STREQUAL "0")
        file(APPEND "${log}" "${source} (${entry}) failed (status ${status})\n${compiler_output}${compiler_error}")
        message(FATAL_ERROR "Shader candidate compilation failed")
    endif()
    if(NOT EXISTS "${interfaces}/${output}.json")
        file(APPEND "${log}" "Missing baseline interface for ${output}. Build the renderer first.\n")
        message(FATAL_ERROR "Baseline shader interface is unavailable")
    endif()
    file(SHA256 "${interfaces}/${output}.json" original)
    file(SHA256 "${reflection}" replacement)
    if(NOT original STREQUAL replacement)
        file(APPEND "${log}" "${source} (${entry}) changed its reflected interface. Rebuild the renderer to apply interface changes.\n")
        message(FATAL_ERROR "Shader interface changed")
    endif()
    file(APPEND "${RELOAD_DIRECTORY}/compiled.txt" "${output}\n")
    file(REMOVE "${RELOAD_DIRECTORY}/current-stage.txt")
endfunction()

# Entries below are generated from the same shader declarations as the build.
