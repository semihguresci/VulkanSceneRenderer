include_guard(GLOBAL)

add_library(Dep_NanoVDB INTERFACE)
add_library(Dep_NanoVDB_IO INTERFACE)
set(CONTAINER_HAS_NANOVDB 0)
set(CONTAINER_HAS_NANOVDB_IO 0)
set(CONTAINER_NANOVDB_ZIP_ENABLED 0 CACHE INTERNAL "Configured native ZIP provider" FORCE)
set(CONTAINER_NANOVDB_BLOSC_ENABLED 0 CACHE INTERNAL "Configured native BLOSC provider" FORCE)
if(NOT (ENABLE_OPENVDB AND ENABLE_NANOVDB) AND NOT ENABLE_NANOVDB_IO)
    return()
endif()

# NanoVDB's portable CPU/HLSL headers do not need CUDA. The vcpkg OpenVDB
# NanoVDB feature enables CUDA tools, so acquire only these pinned headers.
find_path(NANOVDB_INCLUDE_DIR nanovdb/PNanoVDB.h
    HINTS ${OpenVDB_ROOT} PATH_SUFFIXES include)
if(NOT NANOVDB_INCLUDE_DIR)
    FetchContent_Declare(container_nanovdb
        URL https://github.com/AcademySoftwareFoundation/openvdb/archive/refs/tags/v12.0.1.tar.gz
        URL_HASH SHA512=67b859bf77c53e68116faa7915bb6a5a50a8cff10435762890e13348625e8aebdb6661b722017632471648afe31e2f9d4cd2e18456c728192bfd0accd70a40ef
        SOURCE_SUBDIR nanovdb/nanovdb/math
        DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    # This header subtree has no CMake project; do not add upstream CUDA/tools.
    FetchContent_MakeAvailable(container_nanovdb)
    set(NANOVDB_INCLUDE_DIR "${container_nanovdb_SOURCE_DIR}/nanovdb")
endif()
if(NOT EXISTS "${NANOVDB_INCLUDE_DIR}/nanovdb/PNanoVDB.h" OR
   NOT EXISTS "${NANOVDB_INCLUDE_DIR}/nanovdb/tools/CreateNanoGrid.h")
    message(FATAL_ERROR "ENABLE_NANOVDB requires NanoVDB headers including PNanoVDB.h and tools/CreateNanoGrid.h")
endif()
if(ENABLE_NANOVDB_IO)
    foreach(header IN ITEMS HostBuffer.h io/IO.h tools/GridValidator.h tools/GridChecksum.h)
        if(NOT EXISTS "${NANOVDB_INCLUDE_DIR}/nanovdb/${header}")
            message(FATAL_ERROR "ENABLE_NANOVDB_IO requires NanoVDB headers including ${header}")
        endif()
    endforeach()
endif()
if(ENABLE_OPENVDB AND ENABLE_NANOVDB)
    set(CONTAINER_HAS_NANOVDB 1)
    target_compile_definitions(Dep_NanoVDB INTERFACE CONTAINER_HAS_NANOVDB=1)
endif()
find_file(NANOVDB_LICENSE_FILE NAMES LICENSE copyright
    PATHS "${NANOVDB_INCLUDE_DIR}/.."
          "${NANOVDB_INCLUDE_DIR}/../share/openvdb"
          "${NANOVDB_INCLUDE_DIR}/../share/nanovdb"
    NO_DEFAULT_PATH)
target_include_directories(Dep_NanoVDB SYSTEM INTERFACE "${NANOVDB_INCLUDE_DIR}")
if(ENABLE_OPENVDB)
    target_compile_definitions(Dep_NanoVDB INTERFACE NANOVDB_USE_OPENVDB NANOVDB_USE_TBB)
endif()
target_compile_options(Dep_NanoVDB INTERFACE $<$<CXX_COMPILER_ID:MSVC>:/Zc:__cplusplus>)
message(STATUS "NanoVDB portable headers enabled (no CUDA): ${NANOVDB_INCLUDE_DIR}")
if(ENABLE_NANOVDB_IO)
    set(CONTAINER_HAS_NANOVDB_IO 1)
    target_compile_definitions(Dep_NanoVDB_IO INTERFACE CONTAINER_HAS_NANOVDB_IO=1)
    target_link_libraries(Dep_NanoVDB_IO INTERFACE Dep_NanoVDB)
    if(ENABLE_NANOVDB_ZIP)
        find_package(ZLIB QUIET)
        if(TARGET ZLIB::ZLIB)
            set(CONTAINER_NANOVDB_ZIP_ENABLED 1 CACHE INTERNAL "Configured native ZIP provider" FORCE)
            target_compile_definitions(Dep_NanoVDB_IO INTERFACE CONTAINER_NANOVDB_ZIP=1 NANOVDB_USE_ZIP)
            target_link_libraries(Dep_NanoVDB_IO INTERFACE ZLIB::ZLIB)
        else()
            message(STATUS "NanoVDB ZIP provider unavailable; NONE codec remains enabled")
        endif()
    endif()
    if(ENABLE_NANOVDB_BLOSC)
        find_package(blosc CONFIG QUIET)
        if(TARGET blosc_shared)
            set(CONTAINER_NANOVDB_BLOSC_ENABLED 1 CACHE INTERNAL "Configured native BLOSC provider" FORCE)
            target_compile_definitions(Dep_NanoVDB_IO INTERFACE CONTAINER_NANOVDB_BLOSC=1 NANOVDB_USE_BLOSC)
            target_link_libraries(Dep_NanoVDB_IO INTERFACE blosc_shared)
        elseif(TARGET blosc_static)
            set(CONTAINER_NANOVDB_BLOSC_ENABLED 1 CACHE INTERNAL "Configured native BLOSC provider" FORCE)
            target_compile_definitions(Dep_NanoVDB_IO INTERFACE CONTAINER_NANOVDB_BLOSC=1 NANOVDB_USE_BLOSC)
            target_link_libraries(Dep_NanoVDB_IO INTERFACE blosc_static)
        else()
            message(STATUS "NanoVDB BLOSC provider unavailable; NONE codec remains enabled")
        endif()
    endif()
    # Imported Blosc targets can omit their Snappy runtime edge. FindZLIB can
    # expose an UNKNOWN import library without identifying its DLL. Native-only
    # Windows builds therefore stage the configured providers' runtime closures
    # independently of the OpenVDB staging hook.
    if(WIN32 AND NOT ENABLE_OPENVDB)
        if(TARGET blosc_shared)
            list(APPEND CONTAINER_NANOVDB_RUNTIME_SEEDS "$<TARGET_FILE:blosc_shared>")
        endif()
        if(TARGET ZLIB::ZLIB)
            get_target_property(_nano_zlib_type ZLIB::ZLIB TYPE)
            if(_nano_zlib_type STREQUAL "SHARED_LIBRARY")
                list(APPEND CONTAINER_NANOVDB_RUNTIME_SEEDS "$<TARGET_FILE:ZLIB::ZLIB>")
            elseif(_nano_zlib_type STREQUAL "UNKNOWN_LIBRARY")
                foreach(_nano_config IN ITEMS RELEASE DEBUG)
                    get_target_property(_nano_lib ZLIB::ZLIB "IMPORTED_LOCATION_${_nano_config}")
                    if(NOT _nano_lib)
                        get_target_property(_nano_lib ZLIB::ZLIB IMPORTED_LOCATION)
                    endif()
                    if(_nano_lib)
                        get_filename_component(_nano_lib_dir "${_nano_lib}" DIRECTORY)
                        get_filename_component(_nano_prefix "${_nano_lib_dir}" DIRECTORY)
                        if(_nano_config STREQUAL "DEBUG")
                            set(_nano_zlib_names zlibd1.dll zlib1.dll zlibd.dll zlib.dll)
                        else()
                            set(_nano_zlib_names zlib1.dll zlib.dll)
                        endif()
                        find_file(_nano_zlib_dll_${_nano_config} NAMES ${_nano_zlib_names}
                            PATHS "${_nano_prefix}/bin" NO_DEFAULT_PATH)
                        if(_nano_zlib_dll_${_nano_config})
                            if(_nano_config STREQUAL "DEBUG")
                                list(APPEND CONTAINER_NANOVDB_RUNTIME_SEEDS
                                    "$<$<CONFIG:Debug>:${_nano_zlib_dll_${_nano_config}}>")
                            else()
                                list(APPEND CONTAINER_NANOVDB_RUNTIME_SEEDS
                                    "$<$<NOT:$<CONFIG:Debug>>:${_nano_zlib_dll_${_nano_config}}>")
                            endif()
                        endif()
                    endif()
                endforeach()
            endif()
        endif()
        if(CONTAINER_NANOVDB_RUNTIME_SEEDS)
            get_filename_component(_nano_linker_dir "${CMAKE_LINKER}" DIRECTORY)
            find_program(CONTAINER_NANOVDB_DUMPBIN NAMES dumpbin HINTS "${_nano_linker_dir}")
        endif()
    endif()
endif()
