include_guard(GLOBAL)

# Preserve each complete entry (including release/interface provenance), while
# admitting only the caller's exact runtime dependency set and staged notices.
function(container_merge_selected_dependency_indices output expected_pairs)
    set(_expected_names "")
    foreach(_pair IN LISTS expected_pairs)
        if(NOT _pair MATCHES "^([a-z0-9-]+)=([A-Za-z0-9_.-]+)$")
            message(FATAL_ERROR "Invalid expected selected dependency: ${_pair}")
        endif()
        set(_name "${CMAKE_MATCH_1}")
        list(FIND _expected_names "${_name}" _duplicate)
        if(NOT _duplicate EQUAL -1)
            message(FATAL_ERROR "Duplicate expected selected dependency: ${_name}")
        endif()
        list(APPEND _expected_names "${_name}")
        set("_expected_${_name}" "${CMAKE_MATCH_2}")
    endforeach()
    set(_merged "{\"libraries\":[]}")
    set(_names "")
    set(_notices "")
    get_filename_component(_notice_directory "${output}" DIRECTORY)
    foreach(_fragment IN LISTS ARGN)
        if(NOT EXISTS "${_fragment}")
            message(FATAL_ERROR "Missing selected dependency fragment: ${_fragment}")
        endif()
        file(SIZE "${_fragment}" _size)
        if(_size GREATER 65536)
            message(FATAL_ERROR "Selected dependency fragment exceeds 64 KiB")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_fragment}")
        file(READ "${_fragment}" _json)
        string(JSON _type ERROR_VARIABLE _error TYPE "${_json}" libraries)
        if(NOT _error STREQUAL "NOTFOUND" OR NOT _type STREQUAL "ARRAY")
            message(FATAL_ERROR "Invalid selected dependency fragment: ${_fragment}")
        endif()
        string(JSON _count LENGTH "${_json}" libraries)
        if(_count GREATER 64)
            message(FATAL_ERROR "Selected dependency fragment exceeds 64 libraries")
        endif()
        if(_count EQUAL 0)
            continue()
        endif()
        math(EXPR _last "${_count}-1")
        foreach(_index RANGE 0 ${_last})
            foreach(_field IN ITEMS name version notice sha256)
                string(JSON _type ERROR_VARIABLE _error TYPE "${_json}" libraries ${_index} "${_field}")
                if(NOT _error STREQUAL "NOTFOUND" OR NOT _type STREQUAL "STRING")
                    message(FATAL_ERROR "Selected dependency entry lacks string ${_field}")
                endif()
                string(JSON "_${_field}" GET "${_json}" libraries ${_index} "${_field}")
            endforeach()
            list(FIND _expected_names "${_name}" _expected_index)
            if(_expected_index EQUAL -1 OR NOT _version STREQUAL "${_expected_${_name}}")
                message(FATAL_ERROR "Unexpected selected dependency/version: ${_name} ${_version}")
            endif()
            list(FIND _names "${_name}" _duplicate)
            list(FIND _notices "${_notice}" _notice_duplicate)
            if(NOT _duplicate EQUAL -1 OR NOT _notice_duplicate EQUAL -1)
                message(FATAL_ERROR "Duplicate selected dependency name or notice: ${_name}")
            endif()
            if(IS_ABSOLUTE "${_notice}" OR _notice MATCHES "[/\\]" OR _notice STREQUAL "." OR _notice STREQUAL ".." OR
               NOT _notice MATCHES "^[A-Za-z0-9_.-]+$")
                message(FATAL_ERROR "Selected notice must be a relative basename")
            endif()
            string(LENGTH "${_sha256}" _hash_length)
            if(NOT _hash_length EQUAL 64 OR NOT _sha256 MATCHES "^[a-f0-9]+$")
                message(FATAL_ERROR "Selected notice has malformed SHA256")
            endif()
            if(NOT EXISTS "${_notice_directory}/${_notice}" OR IS_DIRECTORY "${_notice_directory}/${_notice}")
                message(FATAL_ERROR "Selected dependency notice is missing: ${_notice}")
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_notice_directory}/${_notice}")
            file(SHA256 "${_notice_directory}/${_notice}" _actual)
            if(NOT _actual STREQUAL _sha256)
                message(FATAL_ERROR "Selected dependency notice hash mismatch: ${_notice}")
            endif()
            list(APPEND _names "${_name}")
            list(APPEND _notices "${_notice}")
            string(JSON _entry GET "${_json}" libraries ${_index})
            string(JSON _length LENGTH "${_merged}" libraries)
            string(JSON _merged SET "${_merged}" libraries ${_length} "${_entry}")
        endforeach()
    endforeach()
    list(SORT _expected_names)
    list(SORT _names)
    if(NOT _names STREQUAL _expected_names)
        message(FATAL_ERROR "Selected runtime dependency index is incomplete")
    endif()
    file(WRITE "${output}" "${_merged}\n")
endfunction()
