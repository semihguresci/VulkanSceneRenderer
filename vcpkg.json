{
  "dependencies": [
    "gtest",
    "fmt",
    "nlohmann-json",
    "glm",
    "earcut-hpp",
    "manifold",
    "glfw3",
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "vulkan-binding"
      ]
    },
    "vulkan-memory-allocator",
    "shader-slang",
    {
      "name": "tinygltf",
      "default-features": false,
      "features": [
        "legacy-cpp"
      ]
    },
    {
      "name": "tinyexr",
      "default-features": false,
      "features": [
        "legacy-cpp"
      ]
    },
    "stb",
    "mikktspace",
    "spdlog",
    "entt",
    "materialx"
  ],
  "features": {
    "openvdb": {
      "description": "OpenVDB volume import, rendering and voxel/SDF processing",
      "dependencies": [
        "openvdb"
      ]
    }
  }
}
